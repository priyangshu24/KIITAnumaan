# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard → Project Settings → API).

# Safe to expose to the browser — access is enforced by Postgres RLS, not by
# keeping this secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix this with NEXT_PUBLIC_ or import it from a
# 'use client' file — it bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Code execution backend for the FORCE editor (Piston — public, free, no key
# required by default: https://github.com/engineer-man/piston). Point this at
# a self-hosted instance if you outgrow the public one's rate limit.
PISTON_API_URL=https://emkc.org/api/v2/piston
