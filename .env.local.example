# KIIT ANUMAAN — Supabase Configuration
# Fill in your real Supabase URL and Publishable/Anon Key from Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional Server-Only Key (Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Code execution backend for the FORCE editor (Piston - free public default)
PISTON_API_URL=https://emkc.org/api/v2/piston
